{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/review",
      "destination": "https://g.page/r/CZGM0zQdEiY7EAE/review",
      "permanent": false
    },
    {
      "source": "/reviews",
      "destination": "https://g.page/r/CZGM0zQdEiY7EAE/review",
      "permanent": false
    },
    {
      "source": "/drop-review",
      "destination": "https://g.page/r/CZGM0zQdEiY7EAE/review",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/cover/:username",
      "destination": "/api/cover/:username"
    },
    {
      "source": "/api/cover",
      "destination": "/api/cover"
    },
    {
      "source": "/api/vcard/:username",
      "destination": "/api"
    },
    {
      "source": "/api/vcard",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/:username/vcard.vcf",
      "destination": "/api"
    },
    {
      "source": "/@:username/vcard.vcf",
      "destination": "/api"
    },
    {
      "source": "/:username.vcf",
      "destination": "/api"
    },
    {
      "source": "/@:username.vcf",
      "destination": "/api"
    },
    {
      "source": "/vcard.vcf",
      "destination": "/api"
    },
    {
      "source": "/vcard",
      "destination": "/index.html"
    },
    {
      "source": "/:username/vcard",
      "destination": "/index.html"
    },
    {
      "source": "/@:username/vcard",
      "destination": "/index.html"
    },
    {
      "source": "/@:username",
      "destination": "/api?profile=@:username"
    },
    {
      "source": "/p/:username",
      "destination": "/api?profile=:username"
    },
    {
      "source": "/u/:username",
      "destination": "/api?profile=:username"
    },
    {
      "source": "/((?!api/|assets/|favicon|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|whatsapp|twitter|facebook|facebot|linkedin|slack|discord|telegram|applebot|skype|preview|flipboard|tumblr|bitly|vkshare).*"
        }
      ],
      "destination": "/api?ssrPath=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
